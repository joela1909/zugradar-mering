{
  "name": "zugradar-mering",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Zentraler Zähler für das Bahn-Kontingent (60 Anfragen/min, über DB_RATE_LIMIT änderbar)
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "vars": { "DB_RATE_LIMIT": "60" }
}
